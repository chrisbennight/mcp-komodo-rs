KOMODO_MCP_UPSTREAM_URL=http://core:9120/
KOMODO_MCP_READ_API_KEY=replace-with-read-api-key
KOMODO_MCP_READ_API_SECRET=replace-with-read-api-secret
KOMODO_MCP_ADMIN_API_KEY=replace-with-admin-api-key
KOMODO_MCP_ADMIN_API_SECRET=replace-with-admin-api-secret
KOMODO_MCP_GATEWAY_BEARER_CURRENT=replace-with-gateway-bearer
# KOMODO_MCP_GATEWAY_BEARER_PREVIOUS=replace-with-previous-gateway-bearer
KOMODO_MCP_IDENTITY_JWKS_URL=http://mcp-gateway:8080/.well-known/jwks.json
KOMODO_MCP_IDENTITY_ISSUER=https://gateway.example.com
KOMODO_MCP_IDENTITY_ACTOR=gateway.example.com
KOMODO_MCP_ALLOWED_HOSTS=komodo-mcp,komodo-mcp:8000
KOMODO_MCP_LOG_LEVEL=info
# All settings and bounds: docs/configuration.md
# This file is an example, not a dotenv file automatically loaded by the server.
# KOMODO_MCP_HOST=0.0.0.0
# KOMODO_MCP_PORT=8000
# KOMODO_MCP_ALLOWED_ORIGINS=
# KOMODO_MCP_UPSTREAM_TIMEOUT_SECONDS=20
# KOMODO_MCP_REQUEST_TIMEOUT_SECONDS=30
# KOMODO_MCP_MAX_CONCURRENT_REQUESTS=32
# KOMODO_MCP_MAX_BODY_BYTES=1048576
